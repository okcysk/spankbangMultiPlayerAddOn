{
  "manifest_version": 3,
  "name": "SpankBang Quad Player",
  "version": "1.0.6",
  "description": "Select up to four SpankBang search results and play them in a four-panel view.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open SpankBang Quad Player",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "https://*.spankbang.com/*",
    "https://*.spankbang.party/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.spankbang.com/*", "https://*.spankbang.party/*"],
      "js": ["search.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.spankbang.com/*",
        "https://*.spankbang.party/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.spankbang.com/*",
        "https://*.spankbang.party/*"
      ],
      "js": ["visibility.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "options_page": "options.html"
}
